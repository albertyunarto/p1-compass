# P1 Compass environment variables — copy to .env.local and fill in.

# --- OneMap geocoding (optional) ---------------------------------------------
# The app works without these via the bundled postal-sector fallback, but a
# OneMap token gives precise (within ~50m) postal-code geocoding.
#
# Option A: supply a ready access token (expires ~3 days, refresh manually).
ONEMAP_TOKEN=

# Option B: supply account credentials and the app fetches/caches tokens itself.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- AI recommendations (optional) -------------------------------------------
# When GEMINI_API_KEY is set, each school detail view shows AI-generated,
# data-grounded admission recommendations. Without it the section is hidden.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Override the model — defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# --- Analytics (optional) ----------------------------------------------------
# When set, custom events (postal_search, school_detail_open) are sent to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
